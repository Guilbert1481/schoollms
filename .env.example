APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Host-based multi-tenancy (config/tenancy.php, ADR-0007). Each school is
# served at <school-slug>.<base>; reserved labels (e.g. "sophentis") resolve to
# the central/platform context instead of a school.
# Production (staging on philceb.ph): platform/superadmin = sophentis.philceb.ph,
# schools = <slug>.philceb.ph (e.g. memory-ridge.philceb.ph):
#   TENANCY_PRIMARY_BASE_DOMAIN=philceb.ph
#   TENANCY_BASE_DOMAINS=philceb.ph
TENANCY_PRIMARY_BASE_DOMAIN=localhost
TENANCY_BASE_DOMAINS=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Roadmap S4 — off-database security trail. Every audit_logs/login_logs row is
# mirrored to this channel so the trail survives a DB-level compromise. Defaults
# to the append-only `audit` file channel (storage/logs/audit/, shipped off-box
# by the operator); set AUDIT_LOG_CHANNEL=syslog|papertrail for true off-host.
AUDIT_LOG_CHANNEL=audit
AUDIT_LOG_DAYS=365

# Roadmap D3 — PII retention for never-enrolled applicants (config/privacy.php).
# `pii:purge-applicants` erases their data past these windows (RA 10173).
PII_APPLICANT_RETENTION_MONTHS=12
PII_ABANDONED_DRAFT_DAYS=90
PII_PURGE_DEPTH=hard
PII_DELETE_APPLICANT_USER=true

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shared key an unattended attendance device (biometric/facial terminal) sends in
# the X-Device-Key header. Leave blank to keep the device check-in endpoint closed.
ATTENDANCE_DEVICE_SECRET=
