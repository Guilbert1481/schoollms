# Sophentis backup configuration (Roadmap D1/D5).
#
# Copy to /etc/sophentis-backup.env on the VPS, fill in, then:  chmod 600 it.
# This file holds the backup ENCRYPTION PASSPHRASE — it must NEVER be committed
# and must NOT live in the app directory.

# AES-256 passphrase used to encrypt every backup. Generate a strong one
# (e.g. `openssl rand -base64 32`) and STORE IT IN YOUR PASSWORD MANAGER —
# if you lose it, the backups cannot be decrypted. Store it somewhere OTHER
# than this server (a server-only copy dies with the server).
BACKUP_PASSPHRASE=

# Dead-man switch (D5). Create a check at healthchecks.io (or self-hosted) and
# paste its ping URL. The job pings it on success; a MISSED backup then alerts
# you. Leave blank to disable (not recommended for production).
HEALTHCHECK_URL=

# Off-site target as an rclone remote (e.g. "b2:sophentis-backups" or
# "s3:bucket/path"). Configure it first with `rclone config`. Leave blank to
# keep backups local only — which is NOT disaster-safe (disk failure or
# ransomware takes the backups with the DB).
RCLONE_REMOTE=

# Optional overrides (sensible defaults in db-backup.sh):
# BACKUP_DIR=/var/backups/sophentis
# RETENTION_DAYS=14
# APP_DIR=/var/www/schoollms
